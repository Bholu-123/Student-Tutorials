# Used by Vercel serverless function `api/submit-enquiry.js` (set these in Vercel → Settings → Environment Variables).
# Do NOT commit real secrets.

# Optional: IANA timezone for the "Submitted At" column (default Asia/Kolkata)
# ENQUIRY_TIMEZONE=Asia/Kolkata

GOOGLE_SHEET_ID=
# Exact tab name; spaces are OK (e.g. Students from webapp)
GOOGLE_SHEET_TAB=Students from webapp
GOOGLE_CLIENT_EMAIL=
# Paste the full key; use \n for line breaks in Vercel UI, or paste multiline if allowed
GOOGLE_PRIVATE_KEY=

# Optional: override enquiry API URL (default /api/submit-enquiry). Useful for local testing with `vercel dev`.
# VITE_ENQUIRY_API_URL=http://localhost:3000/api/submit-enquiry
